    <template><srai>BETA</srai></template>
  </category>

  <category>
    <pattern>WHY BETA</pattern>
    <template><srai>BETA</srai></template>
  </category>

  <category>
    <pattern>BETA TAG</pattern>
    <template><srai>BETA</srai></template>
