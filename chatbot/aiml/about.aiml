  <!-- ── Quality and samples ─────────────────────────────────────────────── -->

  <category>
    <pattern>IS THE QUALITY GOOD</pattern>
    <template>Every Brass Note Studios commission is produced to broadcast standards — the same quality you'd hear on major streaming platforms. We bring real musical expertise to every lyric, arrangement, and mix, and our three-round revision process ensures the result is exactly what you envisioned. Listen to examples in our portfolio to hear for yourself.
      <nav-card label="Hear Our Work" href="/music" description="Commissioned portfolio"/>
    </template>
  </category>

  <category>
    <pattern>WILL IT SOUND PROFESSIONAL</pattern>
    <template><srai>IS THE QUALITY GOOD</srai></template>
  </category>

  <category>
    <pattern>WILL IT SOUND GOOD</pattern>
