  </category>

  <category>
    <pattern>WHY NOT JUST DO IT MYSELF</pattern>
    <template><srai>WHY NOT JUST USE SUNO MYSELF</srai></template>
  </category>

  <category>
    <pattern>CAN I TELL IT IS AI MUSIC</pattern>
    <template>Our productions consistently pass the listening test — portfolio pieces have earned praise from listeners who never suspected AI was involved. What determines that is the quality of the writing and production direction, not the tool. Hear for yourself on our Music page; the work speaks more clearly than any description of it.
      <nav-card label="Listen for Yourself" href="/music" description="Commissioned portfolio"/>
    </template>
  </category>

  <category>
    <pattern>WILL IT SOUND LIKE AI MUSIC</pattern>
