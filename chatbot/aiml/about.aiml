  <!-- ── Individual founder profiles ───────────────────────────────────── -->

  <category>
    <pattern>WHO IS SHANE WEICKUM</pattern>
    <template>Shane Weickum co-founded Brass Note Studios alongside DeJanae. He brings over a decade of experience in sound production and engineering and 30+ years as a musician and songwriter — and he oversees the creative and production direction of every commission.
      <nav-card label="About the Studio" href="/about"/>
    </template>
  </category>

  <category>
