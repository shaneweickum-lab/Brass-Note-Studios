  <!-- ── Skeptic / Comparison patterns ─────────────────────────────────────── -->

  <category>
    <pattern>WHY NOT JUST USE SUNO MYSELF</pattern>
    <template>Using Suno on your own is a real option — but it gives you the tool without the songwriting. What we bring is thirty years of musical knowledge, original lyrics written around your specific story, and the Brass Note Method: a proprietary three-tier production framework built from systematic reverse engineering. The difference isn't access to the tool; it's everything we put into directing it.
      <nav-card label="Our Method" href="/method" description="Thirty years of craft, systematized"/>
    </template>
  </category>

  <category>
    <pattern>HOW IS THIS DIFFERENT FROM USING SUNO MYSELF</pattern>
    <template><srai>WHY NOT JUST USE SUNO MYSELF</srai></template>
  </category>

