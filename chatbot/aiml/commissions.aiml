  <!-- ── Discovery call ─────────────────────────────────────────────────── -->

  <category>
    <pattern>WHAT IS A DISCOVERY CALL</pattern>
    <template>A discovery call is a brief one-on-one conversation where we hear about your project in depth — the story behind the song, the emotional tone you're after, and any specific details that should shape the writing. It's included with every commission at no extra charge.</template>
  </category>

  <!-- ── Proposal and engagement ────────────────────────────────────────── -->

  <category>
    <pattern>CAN I COMMISSION A SONG FOR A PROPOSAL</pattern>
    <template>A proposal commission is one of the most intimate pieces we create. We write original lyrics around your love story and the moment you're planning, so the music is as personal as the question itself. Starting at $199.
      <nav-card label="Commission Your Proposal Song" href="/contact?service=individual"/>
      <lead-capture/>
    </template>
  </category>

