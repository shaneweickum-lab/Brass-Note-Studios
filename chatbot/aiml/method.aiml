<aiml version="2.0">

  <!-- ── What the Method Is ────────────────────────────────────────────── -->

  <category>
    <pattern>WHAT IS THE BRASS NOTE METHOD</pattern>
    <template>The Brass Note Method is a three-tier proprietary framework for AI music production using Suno AI — built from thirty years of musicianship and reverse-engineered from the prompts behind our strongest outputs. It operates at the architectural level (how a track is structured), the micro-performance level (how every syllable and breath is rendered), and the neural level (how to bypass the model's training associations to produce output the community considers impossible). Every commissioned track is built with it.
      <nav-card label="Explore the Method" href="/method" description="Three tiers. Every commission."/>
    </template>
  </category>

  <category>
    <pattern>TELL ME ABOUT THE BRASS NOTE METHOD</pattern>
    <template><srai>WHAT IS THE BRASS NOTE METHOD</srai></template>
  </category>

