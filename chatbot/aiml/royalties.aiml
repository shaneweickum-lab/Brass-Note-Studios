  </category>

  <category>
    <pattern>STREAMING RIGHTS</pattern>
    <template><srai>HOW DO ROYALTIES WORK</srai></template>
  </category>

  <!-- ── Sync and licensing ──────────────────────────────────────────────── -->

  <category>
    <pattern>SYNC RIGHTS</pattern>
    <template>Sync licensing — placing your song in film, TV, ads, or video content — is covered under your commercial rights. Your 80% royalty share applies to any sync licensing deals. We handle PRO registration so your royalties flow correctly from every sync placement.</template>
  </category>

  <category>
    <pattern>* SYNC *</pattern>
    <template><srai>SYNC RIGHTS</srai></template>
  </category>

  <category>
    <pattern>* LICENSING *</pattern>
    <template>Your commission includes full commercial rights — streaming, sync licensing, broadcast, social media, and live performance. Your 80% royalty share applies to all of these. We handle PRO registration so your licensing revenue flows automatically.</template>
  </category>

  <!-- ── PRO and rights orgs ────────────────────────────────────────────── -->

  <category>
    <pattern>WHAT IS ASCAP</pattern>
    <template><srai>WHAT IS PRO REGISTRATION</srai></template>
  </category>

  <category>
    <pattern>WHAT IS BMI</pattern>
    <template><srai>WHAT IS PRO REGISTRATION</srai></template>
