  </category>

  <category>
    <pattern>WHAT IS THE ROYALTY SPLIT</pattern>
    <template><srai>ROYALTY SPLIT</srai></template>
  </category>

  <category>
    <pattern>HOW DOES THE ROYALTY SPLIT WORK</pattern>
