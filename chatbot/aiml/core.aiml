      <quick-replies><reply>Start a commission</reply><reply>View pricing</reply><reply>No, that's all</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>THANK YOU</pattern>
    <template>It's our pleasure. If you have other questions or are ready to begin your commission, we're here.
