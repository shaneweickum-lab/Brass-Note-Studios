<aiml version="2.0">

  <category>
    <pattern>HELLO</pattern>
    <template>Welcome to Brass Note Studios — a bespoke atelier for original music. I can help you explore commissions, pricing, our process, or anything else about the studio. What brings you here today?
      <quick-replies><reply>Commission a song</reply><reply>View pricing</reply><reply>About the studio</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>HI</pattern>
    <template>Hello! I'm the Atelier Concierge for Brass Note Studios. Whether you're looking to commission an original song, learn about our process, or explore pricing — I'm here to help. What can I do for you?
      <quick-replies><reply>Commission a song</reply><reply>View pricing</reply><reply>About the studio</reply></quick-replies>
    </template>
  </category>

