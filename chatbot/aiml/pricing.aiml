<?xml version="1.0" encoding="UTF-8"?>
<aiml version="2.0">

  <!-- ── Entry points: ask which type first ─────────────────────────────── -->

  <category>
    <pattern>PRICING</pattern>
    <template>We offer three commission types. Which would you like to see pricing for?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>HOW MUCH DOES IT COST</pattern>
    <template>Pricing depends on the type of commission. Which applies to you?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>WHAT IS THE PRICE</pattern>
    <template>We have three commission types, each with their own pricing. Which would you like to explore?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>WHAT ARE YOUR PRICES</pattern>
    <template>We have three commission types, each with their own pricing. Which would you like to explore?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>WHAT ARE * PRICES</pattern>
    <template><srai>WHAT ARE YOUR PRICES</srai></template>
  </category>

  <category>
    <pattern>WHAT IS * PRICE</pattern>
    <template><srai>WHAT IS THE PRICE</srai></template>
  </category>

  <category>
    <pattern>* CURRENT PRICES</pattern>
    <template><srai>WHAT ARE YOUR PRICES</srai></template>
  </category>

  <category>
    <pattern>* CURRENT PRICING</pattern>
    <template><srai>WHAT ARE YOUR PRICES</srai></template>
  </category>

  <category>
    <pattern>HOW MUCH</pattern>
    <template>It depends on the commission type. Which applies to you?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>VIEW PRICING</pattern>
    <template>Which commission type would you like to see pricing for?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>SEE PRICING</pattern>
    <template>Which commission type would you like to see pricing for?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>SHOW ME PRICING</pattern>
    <template>Which commission type would you like to see pricing for?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>TELL ME ABOUT PRICING</pattern>
    <template>We have three commission types. Which would you like to see pricing for?
      <quick-replies><reply>Individual</reply><reply>Organization</reply><reply>Content Creator</reply></quick-replies>
    </template>
  </category>

  <category>
    <pattern>SEE INDIVIDUAL PRICING</pattern>
    <template>Individual commission pricing:

Single (1 song)        $199
EP (3–4 songs)         $349
LP (5–7 songs)         $549
Full Album (8+ songs)  $849 · +$99/song over 8

Every package includes 3 revision rounds, broadcast-ready WAV + MP3, full commercial rights, and PRO registration.

We also have optional add-ons — expedited delivery, extra revision rounds, stems, and more. Let me take you to the pricing page to show you everything.
      <nav-card label="See All Pricing &amp; Add-Ons" href="/services#individual" description="Full breakdown + optional add-ons" auto-navigate="true"/>
    </template>
  </category>

  <category>
    <pattern>SEE ORGANIZATION PRICING</pattern>
    <template>Organization commission pricing:

Single (1 song)        $299
EP (3–4 songs)         $449
LP (5–7 songs)         $649
Full Album (8+ songs)  $899 · +$99/song over 8

Every package includes 3 revision rounds, broadcast-ready WAV + MP3, full commercial rights, and PRO registration.

We also have optional add-ons — expedited delivery, extra revision rounds, stems, and more. Let me take you to the pricing page to show you everything.
      <nav-card label="See All Pricing &amp; Add-Ons" href="/services#organization" description="Full breakdown + optional add-ons" auto-navigate="true"/>
    </template>
  </category>

  <category>
    <pattern>SEE CREATOR PRICING</pattern>
    <template>Content Creator commission pricing:

Single (1 track)        $199
EP (3–4 tracks)         $349
LP (5–7 tracks)         $549
Full Album (8+ tracks)  $849 · +$99/track over 8

Every package includes 3 revision rounds, broadcast-ready WAV + MP3, full commercial rights, and PRO registration.

We also have optional add-ons — expedited delivery, extra revision rounds, stems, and more. Let me take you to the pricing page to show you everything.
      <nav-card label="See All Pricing &amp; Add-Ons" href="/services#creator" description="Full breakdown + optional add-ons" auto-navigate="true"/>
    </template>
  </category>

