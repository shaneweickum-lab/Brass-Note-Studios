# Brass Note Studios — environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and must never be committed.

# HTTP Basic Auth credentials for /admin/*
ADMIN_USER=admin
ADMIN_PASS=your-secure-password-here

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in your Supabase project: Settings → API

# Project URL (safe to expose — also used in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key (safe to expose — restricted by RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose this to the browser or commit it
# Used server-side only (Route Handlers, Server Actions, Server Components)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email notifications (Resend) ─────────────────────────────────────────────
# Get your API key at resend.com → API Keys
# Used to notify dejanae@sowedandrooted.com when a client sends a message.
RESEND_API_KEY=re_your_api_key_here

# ── Web Push / VAPID (iOS & Android push notifications for admin PWA) ──────────
# Generate once with: npx web-push generate-vapid-keys
# Add all three to your Vercel project environment variables.
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:your-email@example.com

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get keys at dashboard.stripe.com → Developers → API keys
# Use test keys (sk_test_...) in development, live keys (sk_live_...) in production.

# Secret key — NEVER expose this to the browser
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Publishable key — safe for the browser (not currently used in code)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ── Vercel Analytics REST API ─────────────────────────────────────────────────
# Generate at vercel.com → your project → Settings → API tokens
VERCEL_ACCESS_TOKEN=your-vercel-api-token-here
VERCEL_PROJECT_ID=your-project-id-here
VERCEL_TEAM_ID=your-team-id-here
